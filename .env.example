# Copy to .env.local and fill in. Both are public (NEXT_PUBLIC_*) and inlined
# into the client bundle at build time.

# Canonical site URL — optional; falls back to the Vercel prod URL, then localhost.
# NEXT_PUBLIC_SITE_URL=https://lordofgyms.com

# /balance — the public membership-balance edge function (Supabase).
# Base URL, no trailing slash. GET ?org=&c=<card token> for lookups,
# POST {API}/renew-request with { org, c, phone?, note? }.
NEXT_PUBLIC_BALANCE_API=https://<project-ref>.supabase.co/functions/v1/public-balance

# Which gym the cards belong to (org slug understood by the API).
NEXT_PUBLIC_ORG_SLUG=lord-of-gyms
